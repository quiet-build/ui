{
  "name": "@quietbuildlab/ui",
  "version": "0.6.0",
  "description": "Shared UI component library — the Manuscript design system.",
  "license": "MIT",
  "homepage": "https://quiet-build.github.io/ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quiet-build/ui.git"
  },
  "bugs": "https://github.com/quiet-build/ui/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./themes.css": "./dist/themes/index.css",
    "./themes/manuscript.css": "./dist/themes/manuscript.css",
    "./themes/midnight.css": "./dist/themes/midnight.css",
    "./themes/slate.css": "./dist/themes/slate.css",
    "./themes/sunset.css": "./dist/themes/sunset.css",
    "./themes/ocean.css": "./dist/themes/ocean.css",
    "./themes/mono.css": "./dist/themes/mono.css"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "dev": "vite --config preview/vite.config.ts",
    "preview:build": "vite build --config preview/vite.config.ts",
    "build": "tsup && rm -rf dist/themes && cp -R src/themes dist/themes && cp src/theme.css dist/theme.css && node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/lora": "^5.2.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.6",
    "@vitest/browser-playwright": "^4.1.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.4.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
